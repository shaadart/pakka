# Copy to .env and fill in. Real keys never go in git.

# Comma-separated key pool. Needs at least two for failover. Key ids are key_1, key_2, ...
# in this order. Use keys for the same model so the cache key does not depend on the key.
LLM_API_KEYS=replace-with-key-one,replace-with-key-two

# LiteLLM model name. Check that it is current for your provider.
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite file. In Docker, compose forces sqlite:////data/app.db (the named volume).
# Running without Docker: sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# Comma-separated browser origins allowed to call the backend. Exact scheme and host, no trailing slash.
ALLOWED_ORIGINS=http://localhost:3000

# true turns on the X-Simulate-Failure header. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant for a small business. Answer in the language the customer writes in. Keep replies short and kind.
LLM_TIMEOUT_SECONDS=15

# Offline demo and tests only. Every healthy key answers with this text and no provider is called.
# Leave unset on a real deployment.
# LLM_MOCK_RESPONSE=The capital of France is Paris.

# Frontend build argument: where the browser finds the backend.
VITE_API_BASE_URL=http://localhost:8000
